{
    "components": {
        "schemas": {
            "Address": {
                "description": "bech32-encoded cardano address",
                "example": "addr_test1qpju2uhn72ur6j5alln6nz7dqcgcjal7xjaw7lwdjdaex4qhr3xpz63fjwvlpsnu8efnhfdja78d3vkv8ks6ac09g3usemu2yl",
                "type": "string"
            },
            "ApiTx_ConwayEra": {
                "properties": {
                    "transaction": {
                        "$ref": "#/components/schemas/TextEnvelopeJSON"
                    },
                    "tx_body_hash": {
                        "$ref": "#/components/schemas/TxBodyHash"
                    }
                },
                "required": [
                    "transaction",
                    "tx_body_hash"
                ],
                "type": "object"
            },
            "AssetEntry": {
                "properties": {
                    "amount": {
                        "$ref": "#/components/schemas/Quantity"
                    },
                    "asset": {
                        "$ref": "#/components/schemas/AssetId"
                    }
                },
                "required": [
                    "asset",
                    "amount"
                ],
                "type": "object"
            },
            "AssetId": {
                "description": "Cardano asset ID, either 'lovelace' or POLICY_ID.TOKEN_NAME",
                "type": "string"
            },
            "KeyWitness": {
                "properties": {
                    "public_key": {
                        "$ref": "#/components/schemas/PrivyPublicKey"
                    },
                    "signature": {
                        "$ref": "#/components/schemas/PrivySignature"
                    }
                },
                "required": [
                    "public_key",
                    "signature"
                ],
                "type": "object"
            },
            "PrivyPublicKey": {
                "description": "Privy wallet public key",
                "type": "string"
            },
            "PrivySignature": {
                "description": "Hex-encoded Ed25519 signature returned by Privy raw_sign",
                "type": "string"
            },
            "Quantity": {
                "type": "integer"
            },
            "RawSignArgs": {
                "properties": {
                    "authorization_signature": {
                        "type": "string"
                    },
                    "hash_function": {
                        "$ref": "#/components/schemas/RawSignHashFunction"
                    },
                    "payload_hex": {
                        "type": "string"
                    },
                    "transaction_hex": {
                        "type": "string"
                    },
                    "wallet_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "wallet_id",
                    "authorization_signature"
                ],
                "type": "object"
            },
            "RawSignHashFunction": {
                "type": "string"
            },
            "RawSignResponse": {
                "properties": {
                    "signature": {
                        "type": "string"
                    }
                },
                "required": [
                    "signature"
                ],
                "type": "object"
            },
            "SendFundsRequest": {
                "properties": {
                    "assets": {
                        "items": {
                            "$ref": "#/components/schemas/AssetEntry"
                        },
                        "type": "array"
                    },
                    "receiver": {
                        "$ref": "#/components/schemas/Address"
                    },
                    "senders": {
                        "items": {
                            "$ref": "#/components/schemas/Address"
                        },
                        "type": "array"
                    }
                },
                "required": [
                    "senders",
                    "receiver",
                    "assets"
                ],
                "type": "object"
            },
            "SubmitTxArgs_ConwayEra": {
                "properties": {
                    "transaction": {
                        "$ref": "#/components/schemas/TextEnvelopeJSON"
                    },
                    "witnesses": {
                        "items": {
                            "$ref": "#/components/schemas/KeyWitness"
                        },
                        "type": "array"
                    }
                },
                "required": [
                    "transaction",
                    "witnesses"
                ],
                "type": "object"
            },
            "TextEnvelopeJSON": {
                "description": "Text envelope",
                "properties": {
                    "cborHex": {
                        "description": "The CBOR-serialised value, base-16 encoded",
                        "type": "string"
                    },
                    "description": {
                        "description": "Description of the serialised value",
                        "type": "string"
                    },
                    "type": {
                        "description": "Type of the serialised value",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "TxBodyHash": {
                "description": "Hex-encoded Cardano transaction body hash",
                "type": "string"
            },
            "TxId": {
                "description": "Hex-encoded Cardano transaction ID",
                "type": "string"
            },
            "WalletInfo": {
                "properties": {
                    "address": {
                        "$ref": "#/components/schemas/Address"
                    },
                    "balance": {
                        "items": {
                            "items": [
                                {
                                    "$ref": "#/components/schemas/AssetId"
                                },
                                {
                                    "$ref": "#/components/schemas/Quantity"
                                }
                            ],
                            "maxItems": 2,
                            "minItems": 2,
                            "type": "array"
                        },
                        "type": "array"
                    }
                },
                "required": [
                    "address",
                    "balance"
                ],
                "type": "object"
            }
        }
    },
    "info": {
        "title": "",
        "version": ""
    },
    "openapi": "3.0.0",
    "paths": {
        "/api/v1/healthcheck": {
            "get": {
                "description": "Is the server alive?",
                "responses": {
                    "200": {
                        "content": {
                            "application/json;charset=utf-8": {}
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/raw_sign": {
            "post": {
                "requestBody": {
                    "content": {
                        "application/json;charset=utf-8": {
                            "schema": {
                                "$ref": "#/components/schemas/RawSignArgs"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json;charset=utf-8": {
                                "schema": {
                                    "$ref": "#/components/schemas/RawSignResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Invalid `body`"
                    }
                }
            }
        },
        "/api/v1/send_funds": {
            "post": {
                "requestBody": {
                    "content": {
                        "application/json;charset=utf-8": {
                            "schema": {
                                "$ref": "#/components/schemas/SendFundsRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json;charset=utf-8": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiTx_ConwayEra"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Invalid `body`"
                    }
                }
            }
        },
        "/api/v1/submit_tx": {
            "post": {
                "requestBody": {
                    "content": {
                        "application/json;charset=utf-8": {
                            "schema": {
                                "$ref": "#/components/schemas/SubmitTxArgs_ConwayEra"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json;charset=utf-8": {
                                "schema": {
                                    "$ref": "#/components/schemas/TxId"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Invalid `body`"
                    }
                }
            }
        },
        "/api/v1/wallet/{public_key}": {
            "get": {
                "parameters": [
                    {
                        "in": "path",
                        "name": "public_key",
                        "required": true,
                        "schema": {
                            "description": "Privy wallet public key",
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json;charset=utf-8": {
                                "schema": {
                                    "$ref": "#/components/schemas/WalletInfo"
                                }
                            }
                        },
                        "description": ""
                    },
                    "404": {
                        "description": "`public_key` not found"
                    }
                }
            }
        }
    }
}